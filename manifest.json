{
  "manifest_version": 3,
  "name": "Website Intelligence",
  "version": "0.8.0",
  "description": "Analyze the current website's technology stack, infrastructure, and publicly observable characteristics.",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Website Intelligence",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "cookies"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  }
}
